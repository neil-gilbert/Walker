<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>walker</ToolCommandName>
    <PackageId>Walker.Cli</PackageId>
    <Version>0.1.0-preview.1</Version>
    <Title>Walker</Title>
    <Authors>Neil Gilbert</Authors>
    <Description>Fast, diff-aware mutation verification for AI coding agents.</Description>
    <PackageTags>dotnet;mutation-testing;verification;ai-agents</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/neil-gilbert/Walker</PackageProjectUrl>
    <RepositoryUrl>https://github.com/neil-gilbert/Walker</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../docs/nuget-readme.md" Pack="true" PackagePath="README.md" />
    <None Include="../../LICENSE" Pack="true" PackagePath="" />
    <ProjectReference Include="../Walker.Core/Walker.Core.csproj" />
    <ProjectReference Include="../Walker.Git/Walker.Git.csproj" />
    <ProjectReference Include="../Walker.Roslyn/Walker.Roslyn.csproj" />
    <ProjectReference Include="../Walker.Execution/Walker.Execution.csproj" />
  </ItemGroup>
</Project>
